# Copy to apps/api/.env and apps/web/.env.local and fill in. Never commit real values.

# ---- API (apps/api/.env) ----
ENV=development
SUPABASE_URL=https://<project-ref>.supabase.co
# Postgres via Supabase pooler (Session mode, port 5432). Used in Step 2+.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Gemini API key (https://aistudio.google.com/apikey). Model defaults to gemini-embedding-2.
GEMINI_API_KEY=

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
NEXT_PUBLIC_API_URL=http://localhost:8000
